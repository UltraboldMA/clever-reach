{
    "name": "ultraboldma/clever-reach",
    "description": "Laravel and Livewire integration for the CleverReach API",
    "keywords": [
        "laravel",
        "newsletter",
        "clever-reach"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexej Krzewitzki",
            "email": "alexej.krzewitzki@ultrabold.com",
            "homepage": "https://ultrabold.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "livewire/livewire": "^3.0 || ^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "UltraboldMA\\CleverReach\\CleverReachServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "UltraboldMA\\CleverReach\\": "src/CleverReach/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UltraboldMA\\CleverReach\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "pint",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
